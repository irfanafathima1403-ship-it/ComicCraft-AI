        with col1:
            st.image(panel["image"], use_container_width=True)

        with col2:
            st.markdown(
                f"**Scene:** {panel['scene_description']}"
            )

            if panel["caption"]:
                st.markdown(
                    f"**Caption:** {panel['caption']}"
                )

            if panel["narration"]:
                st.markdown(
                    f"**Narration:** {panel['narration']}"
                )

            if panel["dialogue"]:
                st.markdown(
                    f"**Dialogue:** {panel['dialogue']}"
                )

            with st.expander("Image Prompt"):
                st.write(panel["image_prompt"])

        st.divider()

    st.download_button(
        label="📥 Download Your Comic as PDF",
        data=st.session_state["pdf"],
        file_name=f"comiccraft_{datetime.now().strftime('%Y%m%d_%H%M%S')}.pdf",
        mime="application/pdf",
        use_container_width=True
    )

st.caption("ComicCraft AI — Gemini-powered storytelling and comic creation.")
